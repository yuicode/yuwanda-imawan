---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description, lang = 'id', active = '', canonicalPath = Astro.url.pathname } = Astro.props;
const site = 'https://example.pages.dev'; // Replace with your final Cloudflare Pages URL or custom domain.
const canonical = new URL(canonicalPath, site).toString();
const alternateLang = lang === 'id' ? 'en' : 'id';
const alternatePath = canonicalPath.replace(/^\/(id|en)(?=\/|$)/, `/${alternateLang}`);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08111f" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={alternateLang} href={new URL(alternatePath, site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL('/id/', site).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Yuwanda Imawan" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-[#4ade80] focus:px-4 focus:py-2 focus:text-black">Skip to content</a>
    <Header lang={lang} active={active} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
