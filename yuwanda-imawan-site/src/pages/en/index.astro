---
import BaseLayout from '../../layouts/BaseLayout.astro';
const projects = [
  { number: '01', title: 'Network Infrastructure & Troubleshooting', category: 'Networking', status: 'In Progress', description: 'Notes on topology, network segmentation, Wi-Fi, and a structured approach to connectivity troubleshooting.' },
  { number: '02', title: 'IT Network Monitoring Lab', category: 'Monitoring', status: 'Planned', description: 'A lab plan for tracking availability, latency, packet loss, and incident notifications.' },
  { number: '03', title: 'AI-Assisted IT Operations', category: 'AI & Automation', status: 'In Progress', description: 'Experiments with Ubuntu, Docker, and AI agents to support IT documentation and workflows.' },
];
---
<BaseLayout lang="en" active="home" title="Yuwanda Imawan | IT Network Engineer" description="Yuwanda Imawan's portfolio covering networking, IT infrastructure, monitoring, Linux, Docker, and AI automation." canonicalPath="/en/">
  <section class="container grid items-center gap-12 py-20 md:grid-cols-[1.2fr_.8fr] md:py-28"><div><p class="eyebrow">IT NETWORK ENGINEER · INDONESIA</p><h1 class="mt-5 max-w-3xl text-4xl font-black leading-[1.08] tracking-[-.045em] sm:text-6xl">Building <span class="text-[#4ade80]">reliable networks.</span><br/>Automating IT with AI.</h1><p class="muted mt-6 max-w-2xl text-lg leading-8">I'm Yuwanda Imawan. I focus on network infrastructure, troubleshooting, monitoring, and automation experiments that make IT operations more reliable and efficient.</p><div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="/en/projects/">Explore projects <span aria-hidden="true">↗</span></a><a class="btn btn-secondary" href="/en/about/">About me</a></div><div class="mt-8 flex flex-wrap gap-2">{['Networking', 'Infrastructure', 'Monitoring', 'AI Automation'].map((item) => <span class="tag">{item}</span>)}</div></div>
    <div class="panel relative overflow-hidden p-6 sm:p-8"><div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-[#4ade80]/10 blur-3xl"></div><div class="relative mx-auto grid aspect-square max-w-[290px] place-items-center rounded-[2rem] border border-dashed border-[#496079] bg-[#0a1525]"><div class="text-center"><div class="mx-auto grid h-28 w-28 place-items-center rounded-full border border-[#4ade80]/50 bg-[#4ade80]/10 text-4xl font-black text-[#4ade80]">YI</div><p class="mt-5 font-bold">Yuwanda Imawan</p><p class="muted mt-1 text-sm">Profile photo placeholder</p><p class="mt-3 text-xs text-slate-500">Replace with a professional photo</p></div></div><div class="relative mt-6 grid grid-cols-2 gap-3"><div class="rounded-xl border border-[#26364b] bg-[#0b1627] p-3"><p class="text-sm font-bold">Reliable</p><p class="muted mt-1 text-xs">Infrastructure first</p></div><div class="rounded-xl border border-[#26364b] bg-[#0b1627] p-3"><p class="text-sm font-bold">Curious</p><p class="muted mt-1 text-xs">Always learning</p></div></div></div>
  </section>
  <section class="border-y border-[#26364b] bg-[#0c1727]/70"><div class="container grid gap-6 py-8 sm:grid-cols-3"><div><p class="eyebrow">01 / NETWORK</p><p class="mt-2 font-bold">Connectivity & reliability</p><p class="muted mt-1 text-sm">Routing, switching, Wi-Fi, and troubleshooting.</p></div><div><p class="eyebrow">02 / INFRASTRUCTURE</p><p class="mt-2 font-bold">Servers & systems</p><p class="muted mt-1 text-sm">Linux, Docker, and IT infrastructure operations.</p></div><div><p class="eyebrow">03 / AUTOMATION</p><p class="mt-2 font-bold">Monitoring & AI</p><p class="muted mt-1 text-sm">Building safer, more efficient operational workflows.</p></div></div></section>
  <section class="container section"><div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div><p class="eyebrow">SELECTED WORK</p><h2 class="section-title mt-3">Projects I'm building</h2><p class="muted mt-3 max-w-2xl">A portfolio based on real documentation and testing, with transparent project statuses.</p></div><a class="font-semibold text-[#4ade80] hover:underline" href="/en/projects/">All projects ↗</a></div><div class="mt-8 grid gap-4 md:grid-cols-3">{projects.map((p) => <article class="panel card-link p-5"><div class="flex items-center justify-between"><span class="text-xs font-black tracking-widest text-[#4ade80]">PROJECT {p.number}</span><span class="tag">{p.status}</span></div><p class="muted mt-5 text-xs">{p.category}</p><h3 class="mt-2 text-xl font-extrabold leading-snug">{p.title}</h3><p class="muted mt-3 text-sm leading-7">{p.description}</p><a class="mt-5 inline-flex text-sm font-bold text-[#4ade80]" href="/en/projects/">View project list ↗</a></article>)}</div></section>
  <section class="container pb-20"><div class="panel grid gap-6 p-6 sm:grid-cols-[1fr_auto] sm:items-center sm:p-9"><div><p class="eyebrow">LET'S CONNECT</p><h2 class="mt-3 text-2xl font-black">Let's connect and share practical IT solutions.</h2><p class="muted mt-2 max-w-2xl">Open to technical discussions, collaboration, and professional opportunities.</p></div><a class="btn btn-primary" href="/en/contact/">Contact me ↗</a></div></section>
</BaseLayout>
